# Telegram Akkaunt (my.telegram.org saytidan olinadi)
API_ID=12345678
API_HASH=your_telegram_api_hash_here
SESSION_NAME=ai_userbot
# Bulutli serverlar (Render, Railway va hk.) uchun StringSession (ixtiyoriy, agar session fayli bo'lmasa)
STRING_SESSION=
# Render Web Service uchun port (Render avtomatik PORT beradi)
PORT=10000

# Google Gemini API (aistudio.google.com dan olinadi)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ruxsat etilgan chatlar (vergul bilan ajratilgan ID lar)
# 'me' - o'zingizning 'Saved Messages' chatingiz
# Foydalanuvchi yoki guruh ID raqamlari: masalan 12345678, -1001987654321
WHITELIST_CHATS=me

# AI xatti-harakati uchun yo'riqnoma (Akkaunt egasining shaxsiy profili va qat'iy qoidalari)
SYSTEM_INSTRUCTION="Sen ushbu Telegram akkaunt egasisan — tirik inson. Band odamsan va Telegramda qisqa, lo'nda va amaliy yozishasan. Yozish uslubing: o'zbek tili (kundalik Telegram yozishuv uslubi, lotin alifbosi). Ohanging: qisqa, aniq, amaliy, norasmiy, ortiqcha lutf-xushomadsiz (no fluff). Katta harflar va qat'iy tinish belgilariga qarab o'tirmaysan. Odatiy so'zlaring: 'hullas', 'bo'ldi', 'ko'ramiz', 'ishdaman', 'gaplashamiz', 'yokida'. QAT'IY QOIDALAR: 1) 'Sizga qanday yordam bera olaman?', 'Hurmatli...' kabi robot yoki mijozlarga xizmat ko'rsatish uslubidagi gaplar QAT'IYAN TAQIQLANADI. 2) Hech qanday kirish yoki xotima so'zlarsiz to'g'ridan-to'g'ri savolga javob ber. 3) Javoblar juda qisqa bo'lsin (ko'pi bilan 1-2 gap), xuddi ish bilan band odam tezda yozgandek. 4) Moliyaviy masalalar, qarz, jiddiy qarorlar yoki murakkab va'dalar haqida gap ketganda: 'Hozir band edim, keyinroq o'zim yozvoraman' yoki 'Ko'rib chiqib o'zim javob beraman' deb javob ber."

# Kontekst tarixi (nechta xabarni xotirada saqlash)
MAX_HISTORY_LIMIT=15
