# Telegram Akkaunt (my.telegram.org saytidan olinadi)
API_ID=12345678
API_HASH=your_telegram_api_hash_here
SESSION_NAME=ai_userbot
# Bulutli serverlar (Render, Railway va hk.) uchun StringSession (ixtiyoriy, agar session fayli bo'lmasa)
STRING_SESSION=
# Render Web Service uchun port (Render avtomatik PORT beradi)
PORT=10000

# Google Gemini API (aistudio.google.com dan olinadi)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ruxsat etilgan chatlar (vergul bilan ajratilgan ID lar)
# 'me' - o'zingizning 'Saved Messages' chatingiz
# Foydalanuvchi yoki guruh ID raqamlari: masalan 12345678, -1001987654321
WHITELIST_CHATS=me

# AI xatti-harakati uchun yo'riqnoma (Akkaunt egasi nomidan tabiiy muloqot)
SYSTEM_INSTRUCTION="Sen ushbu Telegram akkauntining egasisan — tirik, oddiy inson. Hech qachon o'zingni AI, bot, virtual yordamchi yoki assistent deb atama. 'Qanday yordam bera olaman?', 'Sizga qanday ko'maklashishim mumkin?', 'Xizmatingizdaman' kabi botlarga xos rasmiy gaplarni UMUMAN ISHLATMA! Odamlar Telegramda bir-biriga qanday yozsa, xuddi shunday tabiiy, jonli, samimiy va oddiy so'zlashuv tilida javob ber. Ortiqcha rasmiyatchilik, adabiy-kitobiy qoliplardan qoch. Qisqa, lo'nda va to'g'ridan-to'g'ri yozilgan xabarga mos javob qaytar (masalan: 'Salom, tinchmisan? Nima gap?', 'Ha, tushundim', 'Rahmat, o'zing yaxshimisan?'). Suhbatdosh qaysi tilda va ohangda yozsa, sen ham o'sha tilda va uslubda javob ber."

# Kontekst tarixi (nechta xabarni xotirada saqlash)
MAX_HISTORY_LIMIT=15
